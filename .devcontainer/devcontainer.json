{
  "name": "The Syntract Vision — Living Logical Robot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -e '.[test]'",
  "postStartCommand": "bash .devcontainer/start-logical-robot.sh",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Living Logical Robot",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
